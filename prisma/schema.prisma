generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RsvpStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

enum GiftMethod {
  BANK_TRANSFER
  E_WALLET
}

// ─────────────────────────────────────────────────────────────
// User
// Catatan: saat integrasi Auth.js (nanti), model Account/Session/
// VerificationToken dari adapter Auth.js ditambahkan terpisah,
// relasinya menempel ke model User ini.
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String? // nullable karena nanti bisa login via OAuth (Auth.js)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations Invitation[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Template
// Katalog desain undangan yang bisa dipilih user.
// ─────────────────────────────────────────────────────────────

model Template {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  thumbnailUrl String
  previewUrl   String?
  isPremium    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitations Invitation[]

  @@map("templates")
}

// ─────────────────────────────────────────────────────────────
// Invitation
// Entitas inti: satu undangan yang dibuat user dari sebuah template.
// ─────────────────────────────────────────────────────────────

model Invitation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  slug   String           @unique // dipakai untuk URL publik: momena.id/{slug}
  status InvitationStatus @default(DRAFT)

  title            String // judul acara, mis. "Pernikahan Andi & Sari"
  groomName        String? // nama mempelai pria — dipakai section BrideGroom
  brideName        String? // nama mempelai wanita — dipakai section BrideGroom
  groomParents     String? // mis. "Putra dari Bapak Suryanto & Ibu Wati"
  brideParents     String? // mis. "Putri dari Bapak Hartono & Ibu Rahayu"
  groomInstagram   String? // handle tanpa @, mis. "andi.wijaya"
  brideInstagram   String?
  eventDate        DateTime?
  eventLocation    String?
  eventAddress     String?
  eventMapsUrl     String?
  description      String?
  coverImageUrl       String?
  coverImagePublicId  String?
  groomPhotoUrl       String?
  groomPhotoPublicId  String?
  bridePhotoUrl       String?
  bridePhotoPublicId  String?
  quote            String? // kutipan/ayat pendek — dipakai section Quote
  videoUrl         String? // URL video (YouTube/Vimeo) — dipakai section Video

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gallery  Gallery[]
  rsvps    Rsvp[]
  gifts    Gift[]
  stories  Story[]
  settings Settings?

  @@index([userId])
  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────
// Gallery
// Foto-foto yang ditampilkan di undangan.
// ─────────────────────────────────────────────────────────────

model Gallery {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  imageUrl      String
  imagePublicId String?
  caption       String?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("galleries")
}

// ─────────────────────────────────────────────────────────────
// Story
// Kisah cinta / linimasa hubungan — ditampilkan section LoveStory/Timeline.
// ─────────────────────────────────────────────────────────────

model Story {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  title       String // mis. "Pertama Bertemu"
  date        String? // teks bebas, mis. "Januari 2020" — bukan DateTime,
  // supaya admin bisa isi presisi sesuka mereka tanpa dipaksa tanggal penuh
  description String
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("stories")
}

// ─────────────────────────────────────────────────────────────
// Rsvp
// Konfirmasi kehadiran tamu. Tidak butuh akun (guest langsung isi form).
// ─────────────────────────────────────────────────────────────

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  guestName      String
  phone          String?
  attendeeCount  Int        @default(1)
  status         RsvpStatus @default(ATTENDING)
  message        String? // ucapan dari tamu, ditampilkan di guest book

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("rsvps")
}

// ─────────────────────────────────────────────────────────────
// Gift
// "Amplop digital" — daftar rekening/e-wallet yang ditampilkan di undangan.
// Satu invitation bisa punya beberapa metode.
// ─────────────────────────────────────────────────────────────

model Gift {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  method GiftMethod

  // diisi kalau method = BANK_TRANSFER
  bankName      String?
  accountNumber String?
  accountHolder String?

  // diisi kalau method = E_WALLET
  ewalletName   String?
  ewalletNumber String?

  note  String?
  order Int     @default(0)

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("gifts")
}

// ─────────────────────────────────────────────────────────────
// Settings
// Pengaturan tampilan/visibilitas per invitation (1-1).
// ─────────────────────────────────────────────────────────────

model Settings {
  id           String     @id @default(cuid())
  invitationId String     @unique
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  showGallery Boolean @default(true)
  showRsvp    Boolean @default(true)
  showGift    Boolean @default(true)

  musicUrl String?

  isPasswordProtected Boolean @default(false)
  accessCode          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
